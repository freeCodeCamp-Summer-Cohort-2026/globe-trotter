# Copy this file to .env and change the password before use

NODE_ENV='test'

# Database
POSTGRES_USER=globe-trotter
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
POSTGRES_DB=globe-trotter
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/globe_trotter

# Server URLs
WEB_URL='http://localhost:3000'
NEXT_PUBLIC_API_URL='http://localhost:4000'

# Auth
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME