# Copy this file to .env and change the password before use

# Testing
NODE_ENV=development

# Database
POSTGRES_USER=globe-trotter
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
POSTGRES_DB=globe_trotter
DATABASE_URL=postgres://globe-trotter:CHANGE_ME_PASSWORD@localhost:5432/globe_trotter
TEST_DATABASE_URL=postgres://globe-trotter:CHANGE_ME_PASSWORD@localhost:5432/globe_trotter_test
MIGRATION_TEST_DATABASE_URL=postgres://globe-trotter:CHANGE_ME_PASSWORD@localhost:5432/globe_trotter_migration_test

# Server URLs
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:4000 # Change URL for production
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Email
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@localhost
RESEND_API_KEY=CHANGE_ME_API_KEY
SMTP_HOST=localhost
SMTP_PORT=1025